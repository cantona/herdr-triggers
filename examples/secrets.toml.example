# Copy to $(herdr plugin config-dir cantona.herdr-triggers)/secrets.toml and chmod 600.
# The daemon refuses to read this file at any other mode.
#
#   install -m 600 examples/secrets.toml.example \
#     "$(herdr plugin config-dir cantona.herdr-triggers)/secrets.toml"
#
# Referenced from triggers.toml as ${secret:NAME}. Never put these in
# herdr-plugin.toml or triggers.toml.

DEVICE_USER = "admin"
DEVICE_PASS = "change-me"
